<Window x:Class="PYV_MaterialScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PYV_MaterialScanner"
        mc:Ignorable="d"
        Title="PY-Vina RHF Charge Material Scanner" 
        Width="1920" Height="1080"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        UseLayoutRounding="True"
        Icon="/qr-scan.ico.ico"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />   <!-- 0. 타이틀 바 -->
            <RowDefinition Height="780" />  <!-- 1. 메인 CCTV 영상 (16:9 높이) -->
            <RowDefinition Height="100*" /> <!-- 2. 하단 스캔 결과 영역 (약 180px) -->
            <RowDefinition Height="70" />   <!-- 3. 상태 표시줄 및 버튼 -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />     <!-- 0. 좌측 여백 -->
            <ColumnDefinition Width="693"/>     <!-- 1. 메인 CCTV 좌측 절반 -->
            <ColumnDefinition Width="693"/>     <!-- 2. 메인 CCTV 우측 절반 (총 1386px) -->
            <ColumnDefinition Width="*" />      <!-- 3. 우측 포커스 및 히스토리 패널 (약 514px) -->
        </Grid.ColumnDefinitions>

        <!-- ============================================= -->
        <!--  0. CUSTOM TITLE BAR                          -->
        <!-- ============================================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#2C3E50">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,5,5,5">
                <!-- 메인 아이콘 표시 (프로젝트 내에 icon.ico 파일이 있어야 합니다) -->
                <Image Source="qr-scan.ico.ico" Width="28" Height="28" Margin="10,0,10,0"/>

                <TextBlock Text="{Binding AppTitleWithVersion}" 
                               Foreground="White" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ============================================= -->
        <!--  1. MAIN CCTV VIDEO FEED (16:9 비율 유지)     -->
        <!-- ============================================= -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                BorderBrush="Gray" BorderThickness="1" Background="Black" 
                Margin="0,10,10,10">
            <Grid>
                <!-- Stretch="Uniform"으로 원본 비율 유지, HighQuality로 계단 현상 방지 -->
                <Image x:Name="CameraFeedImage" 
                       Source="{Binding VideoSource}"
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- 상단 FPS 및 해상도 오버레이 표시 -->
                <TextBlock Text="{Binding FpsText}" 
                           Foreground="Yellow" FontSize="18" Margin="10"
                           VerticalAlignment="Top" HorizontalAlignment="Left"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ============================================= -->
        <!--  2. 하단 마지막 스캔 결과 텍스트 (메인 비디오 폭 1386px과 일치) -->
        <!-- ============================================= -->
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                BorderBrush="DarkGray" BorderThickness="0,2,0,0" 
                Margin="0,5,10,5" Padding="0,5,0,0">
            <Border BorderBrush="DarkRed" BorderThickness="2" Background="#FFF5F5" Margin="0,2,0,0">
                <Viewbox Stretch="Uniform" Margin="30,10,30,10">
                    <TextBlock x:Name="LastScannedDataTextBlock"
                               Text="{Binding LastScannedData}" 
                               Foreground="DarkRed" 
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" Direction="315" ShadowDepth="1" BlurRadius="2" Opacity="0.3" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
            </Border>
        </Border>

        <!-- ============================================= -->
        <!--  3. 우측 사이드 패널: 캡처 프리뷰 + 대형 히스토리 병합 -->
        <!-- ============================================= -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" Margin="5,10,15,5">
            <Grid.RowDefinitions>
                <!-- 3-A. 상단: 캡처 라벨 이미지 창 (높이 고정 약 450px) -->
                <RowDefinition Height="450" />
                <!-- 3-B. 하단: Scan History (Row 1과 Row 2의 남은 전체 공간을 채움) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- [상단] 타이틀 없이 순수 이미지만 100% 꽉 채운 검은색 뷰포트 -->
            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Background="Black">
                <Image x:Name="CapturedImageBox" 
                       Source="{Binding CapturedImageSource}" 
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- [하단] 대형 Scan History 테이블 (타이틀 바 없이 리스트 헤더로 즉시 시작) -->
            <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Background="#FFFFFF">
                <ListView x:Name="ScanHistoryListView" 
                          ItemsSource="{Binding ScanHistory}"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          FontWeight="Normal" 
                          FontSize="18"
                          Background="#FFFFFF"
                          BorderThickness="0">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="42"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <!-- 컬럼 폭: Time(200), Scan Data(280) -->
                            <GridViewColumn Header="Time" Width="200" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Scan Data" Width="280" DisplayMemberBinding="{Binding Data}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <!-- ============================================= -->
        <!--  4. 하단 상태 표시줄 및 제어 버튼 (Row 3)       -->
        <!-- ============================================= -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" 
                BorderBrush="DarkGray" BorderThickness="0,1,0,0" Background="#E0E0E0">
            <DockPanel Margin="20,0" LastChildFill="False" VerticalAlignment="Center">

                <!-- 좌측: 카메라 연결 상태 표시 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Camera Status: " FontWeight="Bold" FontSize="20" Foreground="#333333"/>
                    <TextBlock x:Name="ConnectionStatusTextBlock" 
                               Text="{Binding CameraStatusText}" 
                               Foreground="{Binding CameraStatusColor}" 
                               FontSize="20" FontWeight="Bold" Width="300" />
                </StackPanel>

                <!-- 우측: 제어 버튼 그룹 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">

                    <!-- 광학 줌 제어 버튼 (비활성화 상태 보존)[cite: 9] -->
                    <RepeatButton x:Name="ZoomInBtn" Content="Zoom In ➕" 
                                  Command="{Binding ZoomInCommand}" 
                                  PreviewMouseLeftButtonUp="ZoomButton_PreviewMouseLeftButtonUp"                                                                  
                                  Padding="15,10" Margin="0,0,5,0" 
                                  FontSize="16" FontWeight="Bold" Background="#E6F2FF"
                                  Visibility="Collapsed"/>

                    <RepeatButton x:Name="ZoomOutBtn" Content="Zoom Out ➖" 
                                  Command="{Binding ZoomOutCommand}" 
                                  PreviewMouseLeftButtonUp="ZoomButton_PreviewMouseLeftButtonUp"
                                  Padding="15,10" Margin="0,0,25,0" 
                                  FontSize="16" FontWeight="Bold" Background="#FFF0F0"
                                  Visibility="Collapsed"/>

                    <!-- 수동 캡처 버튼 -->
                    <Button x:Name="CaptureImageButton" Content="📸 Capture Image" 
                            Command="{Binding CaptureImageCommand}" 
                            Padding="20,10" Margin="0,0,15,0" 
                            FontSize="16" FontWeight="Bold" 
                            Background="#FFFFE0" BorderBrush="#FFD700" BorderThickness="1"
                            ToolTip="수동 이미지 캡처"/>

                    <!-- 시스템 제어 버튼 -->
                    <Button x:Name="OpenFolderButton" Content="📂 Open Folder" 
                            Command="{Binding OpenFolderCommand}" 
                            Padding="20,10" Margin="0,0,15,0" 
                            FontSize="16" FontWeight="Bold" Background="#FFFFFF"/>

                    <Button x:Name="ReconnectButton" Content="🔄 Re-connect Camera" 
                            Command="{Binding ConnectCommand}" 
                            Padding="20,10" 
                            FontSize="16" FontWeight="Bold" Background="#FFFFFF"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>

</Window>