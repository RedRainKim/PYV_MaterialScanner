<Window x:Class="PYV_MaterialScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PYV_MaterialScanner"
        mc:Ignorable="d"
        Title="PY-Vina RHF Charge Material Scanner" Height="800" Width="1280"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        UseLayoutRounding="True"
        Icon="/qr-scan.ico.ico">


    <!-- 
    Main layout using a Grid with 5 rows:
    0. Custom Title Bar (새로 추가됨)
    1. Video Feed Area (takes up most of the space)
    2. QR Code Data Area (fixed height for data display)
    3. Status Bar (at the very bottom)
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <!-- 새로 추가된 커스텀 타이틀 바 영역 -->
            <RowDefinition Height="340" />
            <RowDefinition Height="200*"/>
            <RowDefinition Height="160" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="480" />
        </Grid.ColumnDefinitions>

        <!-- ============================================= -->
        <!--  0. CUSTOM TITLE BAR                          -->
        <!-- ============================================= -->
        <Border Grid.Row="0" Grid.ColumnSpan="7" Background="#2C3E50">
            <!-- Left 여백 2배 증가 (15 -> 30) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                <!-- 메인 아이콘 표시 (프로젝트 내에 icon.ico 파일이 있어야 합니다) -->
                <Image Source="qr-scan.ico.ico" Width="28" Height="28" Margin="0,0,10,0"/>

                <TextBlock Text="PY-Vina RHF Charge Material Scanner ver_3.5" 
                           Foreground="White" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ============================================= -->
        <!--  1. UPPER AREA: CCTV VIDEO FEED               -->
        <!-- ============================================= -->
        <!-- Top, Left 여백 2배 증가 (10,10,5,5 -> 20,20,5,5) -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" 
                BorderThickness="1" Margin="0,20,5,5" Background="Black"
                Grid.RowSpan="2" Grid.ColumnSpan="4">
            <Grid>
                <!-- 
                     UPDATED: Added RenderOptions.BitmapScalingMode="HighQuality" 
                     This is critical for 4K cameras. Without this, downscaling 4K to the UI size 
                     looks jagged/pixelated (Aliasing). HighQuality uses Fant/Bicubic resampling.
                -->
                <Image x:Name="CameraFeedImage" 
                       Source="{Binding VideoSource}"
                       Stretch="Uniform" 
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Canvas Overlay for ROI Selection -->
                <Canvas x:Name="ROICanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                        Cursor="Cross">

                    <!-- ROI Selection Ractangle -->
                    <Rectangle x:Name="SelectionRectangle"
                               Stroke="Red"
                               StrokeThickness="3"
                               StrokeDashArray="5,3"
                               Fill="#33FFFFFF"
                               Visibility="Collapsed" />

                    <!-- Corner Handles (4 circles) -->
                    <Ellipse x:Name="HandleTopLeft" Fill="Cyan" Width="12" Height="12" 
                             Visibility="Collapsed" Cursor="SizeNWSE"/>
                    <Ellipse x:Name="HandleTopRight" Fill="Cyan" Width="12" Height="12" 
                             Visibility="Collapsed" Cursor="SizeNESW"/>
                    <Ellipse x:Name="HandleBottomLeft" Fill="Cyan" Width="12" Height="12" 
                             Visibility="Collapsed" Cursor="SizeNESW"/>
                    <Ellipse x:Name="HandleBottomRight" Fill="Cyan" Width="12" Height="12" 
                             Visibility="Collapsed" Cursor="SizeNWSE"/>
                </Canvas>

                <!-- FPS Display -->
                <TextBlock Text="{Binding FpsText}" 
                           Foreground="Yellow" 
                           FontSize="20" 
                           Margin="5,5,5,5"
                           IsHitTestVisible="False"/>

                <!-- ROI Mode Indicator -->
                <TextBlock x:Name="RoiModeIndicator"
                           Text="🖱️ DRAG TO SELECT ROI AREA"
                           Foreground="Red" 
                           FontSize="30" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,30,0,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRoiEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="4"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ============================================= -->
        <!--  1-2 UPPER AREA: CAPTURED IMAGE BOX           -->
        <!-- ============================================= -->
        <!-- Top, Right 여백 2배 증가 (5,10,10,5 -> 5,20,20,5) -->
        <Grid Grid.Row="1" Grid.Column="5" Margin="5,20,2,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Edit ROI 버튼 및 수동 Capture Image 버튼을 그룹박스 바깥 상단에 배치 (너비 꽉 채움) -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="EditRoiButton"
                        Grid.Column="0"
                        Content="✏️ Edit Scan Area"
                        Click="EditRoiButton_Click"
                        Padding="8,6"
                        Margin="0,0,5,0"
                        ToolTip="Click to enable selection mode, then drag on the video to select area"/>

                <!-- Capture Image 버튼 -->
                <Button x:Name="CaptureImageButton"
                        Grid.Column="1"
                        Content="📸 Capture Image"
                        Command="{Binding CaptureImageCommand}"
                        Background="#FFFFE0"
                        BorderBrush="#FFD700"
                        BorderThickness="1"
                        FontWeight="Bold"
                        Padding="8,6"
                        Margin="5,0,0,0"
                        ToolTip="Click to capture current video frame manually if QR is not scanned"/>
            </Grid>

            <!-- GroupBox는 이미지만 포함하도록 구성 -->
            <GroupBox Grid.Row="1" 
                      Header="Captured Image (Crop)" 
                      FontWeight="Bold" FontSize="14">
                <Grid Margin="5">
                    <Border BorderBrush="Gray" BorderThickness="1" Background="Black">
                        <Image x:Name="CapturedImageBox" 
                               Stretch="Uniform" 
                               Source="{Binding CapturedImageSource}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ============================================= -->
        <!--  2. MIDDLE AREA: QR CODE DATA DISPLAY         -->
        <!-- ============================================= -->
        <!-- LEFT SIDE: Last Scanned QR Code Data -->
        <!-- Left, Right 여백 2배 증가 (15,5,15,5 -> 30,5,30,5) -->
        <GroupBox Grid.Row="3" Grid.Column="1" Header="Last Scanned QR Code"
                  Grid.ColumnSpan="5"
                  Margin="10,5,4,5" FontWeight="Bold" FontSize="20">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <TextBlock x:Name="LastScannedDataTextBlock"
                           Text="{Binding LastScannedData}"
                           TextWrapping="Wrap"
                           Foreground="DarkRed"
                           FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black"
                                              Direction="315"
                                              ShadowDepth="1"
                                              BlurRadius="1" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Viewbox>
            </Grid>
        </GroupBox>

        <!-- ============================================= -->
        <!--  2-1. MIDDLE AREA: HISTROY OF SCANNED QR CODES-->
        <!-- ============================================= -->
        <!-- Right 여백 2배 증가 (5,5,10,5 -> 5,5,20,5) -->
        <GroupBox Grid.Row="2" Grid.Column="5" 
                  Header="Scan History(Last 50)" 
                  Margin="5,5,2,5" 
                  FontWeight="Bold" 
                  FontSize="14">
            <ListBox x:Name="ScanHistoryListBox" 
                     ItemsSource="{Binding ScanHistory}"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     Margin="5" 
                     FontWeight="Normal"
                     Background="#FFFFFF"
                     BorderBrush="LightGray"
                     BorderThickness="1">
            </ListBox>
        </GroupBox>


        <!-- ============================================= -->
        <!--  3. VERY BOTTOM: STATUS AND CONTROLS          -->
        <!-- ============================================= -->
        <Border Grid.Row="4" Grid.Column="0" 
            Grid.ColumnSpan="7" 
            BorderBrush="DarkGray" 
            BorderThickness="0,1,0,0" 
            Background="#E0E0E0" Margin="0,20,0,0">
            <!-- Left, Right, Bottom 여백 2배 증가 (10,5,10,5 -> 20,5,20,10) -->
            <DockPanel Margin="20,5,20,10" LastChildFill="False">

                <StackPanel Orientation="Horizontal" 
                            DockPanel.Dock="Left" 
                            VerticalAlignment="Center">
                    <TextBlock Text="Camera Status: " 
                               FontWeight="Bold"
                               FontSize="20"/>
                    <TextBlock x:Name="ConnectionStatusTextBlock"
                               FontSize="20"
                               Width="400"
                               Text="{Binding CameraStatusText}" 
                               Foreground="{Binding CameraStatusColor}" />
                </StackPanel>

                <!-- 오른쪽 버튼들 -->
                <StackPanel Orientation="Horizontal" 
                            DockPanel.Dock="Right" 
                            VerticalAlignment="Center" 
                            Margin="20,0,0,0">

                    <Button x:Name="OpenFolderButton" 
                            Content="Open Folder"
                            Command="{Binding OpenFolderCommand}"
                            Padding="10,5"
                            Margin="0,0,10,0" Width="96"/>
                    <Button x:Name="ReconnectButton" 
                            Content="Re-connect Camera"
                            Command="{Binding ConnectCommand}"
                            Padding="10,5"
                            Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>